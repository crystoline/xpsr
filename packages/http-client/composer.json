{
  "name": "crystoline/xpsr-http-client",
  "description": "Outgoing HTTP for XPSR applications: a configured PSR-18 client and named clients, backed by Symfony HttpClient, with a fake client for tests",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.3@dev",
    "psr/http-client": "^1.0.3",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/http-client": "^7.4",
    "symfony/http-client-contracts": "^3.6"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "conflict": {
    "symfony/polyfill-php83": "<1.30"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\HttpClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\HttpClient\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.3.x-dev"
    }
  }
}
