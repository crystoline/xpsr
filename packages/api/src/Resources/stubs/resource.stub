 * $this->resource is the object given; $this->field reads its fields as well.
 */
final class {{ class }} extends Resource
{
    public function toArray(ServerRequestInterface $request): array
    {
        return [
            'id' => $this->resource->id,
            // 'amount' => $this->resource->amount,
            // 'customer' => new CustomerResource($this->whenLoaded('customer')),
            // 'secret' => $this->when($request->getAttribute('admin') === true, $this->resource->secret),
        ];
    }
}
