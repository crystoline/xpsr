{
  "name": "crystoline/xpsr-installer",
  "description": "The xpsr command outside a project: xpsr new creates an XPSR application in one step, and any other command runs the nearest project's own xpsr",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/process": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "bin": [
    "bin/xpsr"
  ],
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Installer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Installer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
