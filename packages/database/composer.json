{
  "name": "crystoline/xpsr-database",
  "description": "Database connections and migrations for XPSR applications, backed by Doctrine DBAL",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.4@dev",
    "doctrine/dbal": "^4.5",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.4"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "ext-pdo_sqlite": "For SQLite databases",
    "ext-pdo_mysql": "For MySQL and MariaDB databases",
    "ext-pdo_pgsql": "For PostgreSQL databases",
    "phpunit/phpunit": "Needed for the DatabaseTransactions and MigratorContractTestCase test helpers"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Database\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Database\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.4.x-dev"
    }
  }
}
