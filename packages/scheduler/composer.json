{
  "name": "crystoline/xpsr-scheduler",
  "description": "Scheduled tasks for XPSR applications: commands, closures, and queued jobs on cron schedules, run from one cron entry",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.4@dev",
    "dragonmantank/cron-expression": "^3.4",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/log": "^3.0",
    "symfony/clock": "^7.4",
    "symfony/console": "^7.4",
    "symfony/lock": "^7.4 || ^8.0",
    "symfony/process": "^7.4"
  },
  "require-dev": {
    "crystoline/xpsr-database": "^0.4@dev",
    "crystoline/xpsr-queue": "^0.4@dev",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "crystoline/xpsr-queue": "Needed for Schedule::job(), which queues a job on its schedule"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Scheduler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Scheduler\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.4.x-dev"
    }
  }
}
