{
  "name": "crystoline/xpsr-orm-doctrine",
  "description": "Doctrine ORM for XPSR applications: an EntityManager on XPSR's database connection, attribute-mapped entities, and migrations generated from the mapping",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-database": "^0.5@dev",
    "crystoline/xpsr-framework": "^0.5@dev",
    "doctrine/dbal": "^4.5",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^4.1",
    "psr/cache": "^2.0 || ^3.0",
    "psr/container": "^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "symfony/cache": "^7.4"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Orm\\Doctrine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Orm\\Doctrine\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
