{
  "name": "crystoline/xpsr-health",
  "description": "Health checks for XPSR applications: live and ready endpoints for load balancers and orchestrators, a health command, and checks of the database, cache, queue and its workers, scheduler, locks, disk space, and HTTP dependencies",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.7@dev",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/console": "^7.4 || ^8.0"
  },
  "require-dev": {
    "crystoline/xpsr-cache": "^0.7@dev",
    "crystoline/xpsr-database": "^0.7@dev",
    "crystoline/xpsr-http-client": "^0.7@dev",
    "crystoline/xpsr-lock": "^0.7@dev",
    "crystoline/xpsr-queue": "^0.7@dev",
    "crystoline/xpsr-router-fastroute": "^0.7@dev",
    "crystoline/xpsr-scheduler": "^0.7@dev",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5",
    "symfony/clock": "^7.4 || ^8.0"
  },
  "suggest": {
    "crystoline/xpsr-database": "The database check",
    "crystoline/xpsr-cache": "The cache check, and the worker and scheduler heartbeats",
    "crystoline/xpsr-queue": "The queue and workers checks",
    "crystoline/xpsr-scheduler": "The scheduler check",
    "crystoline/xpsr-lock": "The locks check",
    "crystoline/xpsr-http-client": "Checks of HTTP dependencies"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Health\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Health\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.7.x-dev"
    }
  }
}
