{
  "name": "crystoline/xpsr-cache",
  "description": "PSR-16 and PSR-6 caching for XPSR applications, backed by Symfony Cache, with a cache:clear command",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.4@dev",
    "psr/cache": "^2.0 || ^3.0",
    "psr/clock": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
    "symfony/cache": "^7.4",
    "symfony/lock": "^7.4 || ^8.0",
    "symfony/rate-limiter": "^7.4"
  },
  "require-dev": {
    "crystoline/xpsr-lock": "^0.4@dev",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "crystoline/xpsr-lock": "Locks shared by several servers, for rate limits counted in a shared cache such as Redis"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Cache\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.4.x-dev"
    }
  }
}
