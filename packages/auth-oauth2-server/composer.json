{
  "name": "crystoline/xpsr-auth-oauth2-server",
  "description": "An OAuth2 authorization server for XPSR applications, on league/oauth2-server: client credentials, authorization code with PKCE, and refresh tokens; the oauth2 guard driver; clients, scopes, and consent",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-database": "^0.7@dev",
    "crystoline/xpsr-framework": "^0.7@dev",
    "defuse/php-encryption": "^2.4",
    "doctrine/dbal": "^4.5",
    "league/oauth2-server": "^8.5.5 || ^9.4",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/console": "^7.4 || ^8.0"
  },
  "require-dev": {
    "crystoline/xpsr-router-fastroute": "^0.7@dev",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5",
    "symfony/clock": "^7.4 || ^8.0",
    "twig/twig": "^3.21"
  },
  "conflict": {
    "lcobucci/clock": "<3.0",
    "league/event": "<2.3"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Auth\\OAuth2\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Auth\\OAuth2\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.7.x-dev"
    }
  }
}
