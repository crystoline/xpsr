{
  "name": "crystoline/xpsr-router-fastroute",
  "description": "FastRoute adapter for XPSR's portable route definitions",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.1@dev",
    "nikic/fast-route": "^1.3"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Router\\FastRoute\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Router\\FastRoute\\Tests\\": "tests/"
    }
  }
}
