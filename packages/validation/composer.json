{
  "name": "crystoline/xpsr-validation",
  "description": "Request validation for XPSR applications: input classes checked with Symfony Validator rules, answered with 422 and field errors",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.3@dev",
    "psr/cache": "^2.0 || ^3.0",
    "psr/container": "^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/property-access": "^7.4",
    "symfony/validator": "^7.4"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "conflict": {
    "symfony/property-info": "<6.4.8 || >=7.0,<7.1",
    "symfony/translation-contracts": "<3.5"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Validation\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Validation\\Symfony\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.3.x-dev"
    }
  }
}
