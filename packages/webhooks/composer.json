{
  "name": "crystoline/xpsr-webhooks",
  "description": "Webhooks for XPSR applications: signed deliveries to subscribed endpoints with retries and a delivery log, and verification of the webhooks providers send",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-database": "^0.5@dev",
    "crystoline/xpsr-framework": "^0.5@dev",
    "crystoline/xpsr-http-client": "^0.5@dev",
    "crystoline/xpsr-queue": "^0.5@dev",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-client": "^1.0.3",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.4 || ^8.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5",
    "symfony/clock": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Webhooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Webhooks\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
