{
  "name": "crystoline/xpsr-auth-jwt",
  "description": "JWT sign-in for XPSR APIs: the jwt guard driver on lcobucci/jwt, a token issuer, and a secret generator",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.3@dev",
    "lcobucci/jwt": "^5.6",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/console": "^7.4"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Auth\\Jwt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Auth\\Jwt\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.3.x-dev"
    }
  }
}
