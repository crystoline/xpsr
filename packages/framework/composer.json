{
  "name": "crystoline/xpsr-framework",
  "description": "XPSR framework library: application lifecycle, PSR-11 container, PSR-15 HTTP kernel, routing contracts, providers, and console",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "composer-runtime-api": "^2.2",
    "illuminate/config": "^12.0",
    "nyholm/psr7-server": "^1.1",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.4",
    "symfony/finder": "^7.4",
    "symfony/process": "^7.4",
    "vlucas/phpdotenv": "^5.6.1"
  },
  "require-dev": {
    "filp/whoops": "^2.18.4",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5",
    "symfony/http-kernel": "^7.4",
    "twig/twig": "^3.4"
  },
  "conflict": {
    "symfony/var-dumper": "<7.4"
  },
  "suggest": {
    "crystoline/xpsr-router-fastroute": "Default router adapter",
    "crystoline/xpsr-router-sunrise": "Alternative router adapter",
    "filp/whoops": "Detailed HTML error pages when APP_DEBUG=true (development only)",
    "twig/twig": "Needed to render views with the view() helper and ViewServiceRegistry",
    "phpunit/phpunit": "Needed to run Crystoline\\Xpsr\\Testing\\RouterContractTestCase in an adapter's own tests"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.2.x-dev"
    }
  },
  "minimum-stability": "stable"
}
