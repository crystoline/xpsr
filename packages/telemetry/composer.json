{
  "name": "crystoline/xpsr-telemetry",
  "description": "Distributed tracing for XPSR applications on the OpenTelemetry SDK: requests, database queries, outgoing HTTP calls, queued jobs, console commands, and scheduled tasks as one trace, exported over OTLP",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.5@dev",
    "crystoline/xpsr-http-client": "^0.5@dev",
    "open-telemetry/api": "^1.8",
    "open-telemetry/context": "^1.4",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/sdk": "^1.15",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "crystoline/xpsr-database": "^0.5@dev",
    "crystoline/xpsr-log-monolog": "^0.5@dev",
    "crystoline/xpsr-queue": "^0.5@dev",
    "crystoline/xpsr-router-fastroute": "^0.5@dev",
    "crystoline/xpsr-scheduler": "^0.5@dev",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5",
    "symfony/clock": "^7.4 || ^8.0"
  },
  "suggest": {
    "crystoline/xpsr-database": "A span per database query",
    "crystoline/xpsr-queue": "A span per queued job, in the trace that queued it",
    "crystoline/xpsr-scheduler": "A span per scheduled task",
    "crystoline/xpsr-log-monolog": "The trace and span IDs on every log line"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Telemetry\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Telemetry\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
