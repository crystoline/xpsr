{
  "name": "crystoline/xpsr-orm-cycle",
  "description": "Cycle ORM for XPSR applications: attribute-mapped entities on XPSR's database connections, with one shared transaction, migrations generated from the schema, entity behaviors, and a user provider",
  "type": "library",
  "license": "MIT",
  "homepage": "https://xpsr.crysto.name.ng",
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-database": "^0.8@dev",
    "crystoline/xpsr-framework": "^0.8@dev",
    "cycle/annotated": "^4.6",
    "cycle/database": "^2.22",
    "cycle/entity-behavior": "^1.7",
    "cycle/orm": "^2.18",
    "cycle/schema-builder": "^2.12",
    "doctrine/dbal": "^4.5",
    "doctrine/inflector": "^2.1",
    "psr/container": "^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "spiral/tokenizer": "^3.17",
    "symfony/console": "^7.4 || ^8.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "crystoline/xpsr-audit": "Automatic auditing of entities with the #[Audited] attribute",
    "crystoline/xpsr-api": "Paging a Select with Pagination"
  },
  "conflict": {
    "spiral/attributes": "<3.1.8"
  },
  "autoload": {
    "psr-4": {
      "Crystoline\\Xpsr\\Orm\\Cycle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crystoline\\Xpsr\\Orm\\Cycle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.8.x-dev"
    }
  }
}
