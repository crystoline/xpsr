parameters:
    level: 5
    tmpDir: var/phpstan
    paths:
        - packages/framework/src
        - packages/framework/tests
        - packages/router-fastroute/src
        - packages/router-fastroute/tests
        - packages/router-sunrise/src
        - packages/router-sunrise/tests
        - packages/cache/src
        - packages/cache/tests
        - packages/http-client/src
        - packages/http-client/tests
        - packages/database/src
        - packages/database/tests
        - packages/orm-doctrine/src
        - packages/orm-doctrine/tests
        - packages/log-monolog/src
        - packages/log-monolog/tests
        - packages/validation/src
        - packages/validation/tests
        - packages/auth-jwt/src
        - packages/auth-jwt/tests
        - packages/notifications/src
        - packages/notifications/tests
        - packages/lock/src
        - packages/lock/tests
        - packages/api/src
        - packages/api/tests
        - packages/installer/src
        - packages/installer/tests
        - packages/view-blade/src
        - packages/view-blade/tests
        - packages/view-latte/src
        - packages/view-latte/tests
        - packages/view-plates/src
        - packages/view-plates/tests
        - packages/storage/src
        - packages/storage/tests
        - packages/scheduler/src
        - packages/scheduler/tests
        - packages/mail/src
        - packages/mail/tests
        - packages/queue/src
        - packages/queue/tests
        - packages/orm-eloquent/src
        - packages/orm-eloquent/tests
        - app
        - bootstrap
        - config/factory.php
        - public/index.php
        - xpsr
        - tests
