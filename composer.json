{
  "name": "crystoline/xpsr",
  "description": "XPSR application skeleton: a PHP framework built around PSR interfaces and interchangeable components",
  "type": "project",
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.2@dev",
    "crystoline/xpsr-router-fastroute": "^0.2@dev",
    "nyholm/psr7": "^1.8.2",
    "twig/twig": "^3.4"
  },
  "require-dev": {
    "crystoline/xpsr-cache": "^0.2@dev",
    "crystoline/xpsr-database": "^0.2@dev",
    "crystoline/xpsr-http-client": "^0.2@dev",
    "crystoline/xpsr-validation": "^0.2@dev",
    "crystoline/xpsr-log-monolog": "^0.2@dev",
    "crystoline/xpsr-orm-doctrine": "^0.2@dev",
    "crystoline/xpsr-router-sunrise": "^0.2@dev",
    "filp/whoops": "^2.18.4",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "symfony/http-kernel": "^7.4"
  },
  "suggest": {
    "crystoline/xpsr-cache": "Application cache (PSR-16 and PSR-6) and the cache:clear command",
    "crystoline/xpsr-database": "Database connections (Doctrine DBAL) and migrations",
    "crystoline/xpsr-http-client": "Outgoing HTTP: a configured PSR-18 client and named clients",
    "crystoline/xpsr-log-monolog": "Monolog logging: stderr, file, daily, or syslog; JSON lines; request IDs",
    "crystoline/xpsr-orm-doctrine": "Doctrine ORM entities on the XPSR database connection",
    "crystoline/xpsr-router-sunrise": "Sunrise router adapter. Select it with: php xpsr setup --router=sunrise --install-dependencies"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true,
        "versions": {
          "crystoline/xpsr-cache": "0.2.x-dev",
          "crystoline/xpsr-database": "0.2.x-dev",
          "crystoline/xpsr-framework": "0.2.x-dev",
          "crystoline/xpsr-http-client": "0.2.x-dev",
          "crystoline/xpsr-validation": "0.2.x-dev",
          "crystoline/xpsr-log-monolog": "0.2.x-dev",
          "crystoline/xpsr-orm-doctrine": "0.2.x-dev",
          "crystoline/xpsr-router-fastroute": "0.2.x-dev",
          "crystoline/xpsr-router-sunrise": "0.2.x-dev"
        }
      }
    }
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Crystoline\\Xpsr\\Cache\\Tests\\": "packages/cache/tests/",
      "Crystoline\\Xpsr\\Database\\Tests\\": "packages/database/tests/",
      "Crystoline\\Xpsr\\Tests\\": "packages/framework/tests/",
      "Crystoline\\Xpsr\\HttpClient\\Tests\\": "packages/http-client/tests/",
      "Crystoline\\Xpsr\\Validation\\Symfony\\Tests\\": "packages/validation/tests/",
      "Crystoline\\Xpsr\\Log\\Monolog\\Tests\\": "packages/log-monolog/tests/",
      "Crystoline\\Xpsr\\Orm\\Doctrine\\Tests\\": "packages/orm-doctrine/tests/",
      "Crystoline\\Xpsr\\Router\\FastRoute\\Tests\\": "packages/router-fastroute/tests/",
      "Crystoline\\Xpsr\\Router\\Sunrise\\Tests\\": "packages/router-sunrise/tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "test:packaging": "phpunit --colors=always --group packaging",
    "test:coverage": "phpunit --coverage-text",
    "analyse": "phpstan analyse --no-progress",
    "style": "php-cs-fixer fix --dry-run --diff",
    "style:fix": "php-cs-fixer fix",
    "check": ["@test", "@analyse", "@style"],
    "serve": "@php xpsr serve",
    "serve-docker": "docker compose up -d --build",
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "extra": {
    "branch-alias": {
      "dev-master": "0.2.x-dev"
    }
  }
}
