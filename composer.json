{
  "name": "crystoline/xpsr",
  "description": "XPSR application skeleton: a PHP framework built around PSR interfaces and interchangeable components",
  "type": "project",
  "require": {
    "php": "^8.4",
    "crystoline/xpsr-framework": "^0.5@dev",
    "crystoline/xpsr-router-fastroute": "^0.5@dev",
    "nyholm/psr7": "^1.8.2",
    "twig/twig": "^3.4"
  },
  "require-dev": {
    "crystoline/xpsr-api": "^0.5@dev",
    "crystoline/xpsr-installer": "^0.5@dev",
    "crystoline/xpsr-auth-jwt": "^0.5@dev",
    "crystoline/xpsr-orm-eloquent": "^0.5@dev",
    "crystoline/xpsr-queue": "^0.5@dev",
    "crystoline/xpsr-mail": "^0.5@dev",
    "crystoline/xpsr-scheduler": "^0.5@dev",
    "crystoline/xpsr-storage": "^0.5@dev",
    "crystoline/xpsr-view-plates": "^0.5@dev",
    "crystoline/xpsr-view-latte": "^0.5@dev",
    "crystoline/xpsr-view-blade": "^0.5@dev",
    "crystoline/xpsr-lock": "^0.5@dev",
    "crystoline/xpsr-notifications": "^0.5@dev",
    "crystoline/xpsr-cache": "^0.5@dev",
    "crystoline/xpsr-database": "^0.5@dev",
    "crystoline/xpsr-http-client": "^0.5@dev",
    "crystoline/xpsr-validation": "^0.5@dev",
    "crystoline/xpsr-log-monolog": "^0.5@dev",
    "crystoline/xpsr-orm-doctrine": "^0.5@dev",
    "crystoline/xpsr-router-sunrise": "^0.5@dev",
    "filp/whoops": "^2.18.4",
    "friendsofphp/php-cs-fixer": "^3.64",
    "illuminate/encryption": "^12.0",
    "laravel/sanctum": "^4.0",
    "league/flysystem-async-aws-s3": "^3.29",
    "minishlink/web-push": "^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "predis/predis": "^3.0",
    "symfony/termii-notifier": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4"
  },
  "suggest": {
    "crystoline/xpsr-api": "JSON API responses: resources with conditional fields and a data envelope, and pagination of DBAL, Doctrine, and Eloquent queries",
    "crystoline/xpsr-auth-jwt": "JWT sign-in for APIs: the jwt guard driver, JwtIssuer, and auth:jwt-secret",
    "crystoline/xpsr-orm-eloquent": "Eloquent models on the XPSR database connection",
    "crystoline/xpsr-queue": "Queued jobs on Symfony Messenger: sync, database, Redis, AMQP, or SQS, with retries and a failed jobs table",
    "crystoline/xpsr-mail": "Email on Symfony Mailer: a DSN transport, templates from the view layer, queued sending",
    "crystoline/xpsr-scheduler": "Scheduled tasks: commands, closures, and queued jobs on cron schedules, from one cron entry",
    "crystoline/xpsr-storage": "File storage on Flysystem: named disks such as local and S3, uploads, and downloads",
    "crystoline/xpsr-view-plates": "Plates (native PHP templates) as the view engine: app.view_engine plates",
    "crystoline/xpsr-view-latte": "Latte (context-aware escaping) as the view engine: app.view_engine latte",
    "crystoline/xpsr-view-blade": "Blade (standalone, through illuminate/view) as the view engine: app.view_engine blade",
    "crystoline/xpsr-lock": "Locks across processes and servers: files, Redis, Redlock, or the database",
    "crystoline/xpsr-notifications": "Notifications by email, SMS, an in-app inbox, and browser push",
    "crystoline/xpsr-cache": "Application cache (PSR-16 and PSR-6) and the cache:clear command",
    "crystoline/xpsr-database": "Database connections (Doctrine DBAL) and migrations",
    "crystoline/xpsr-http-client": "Outgoing HTTP: a configured PSR-18 client and named clients",
    "crystoline/xpsr-log-monolog": "Monolog logging: stderr, file, daily, or syslog; JSON lines; request IDs",
    "crystoline/xpsr-orm-doctrine": "Doctrine ORM entities on the XPSR database connection",
    "crystoline/xpsr-validation": "Request validation: input classes with Symfony Validator rules, 422 with field errors",
    "crystoline/xpsr-router-sunrise": "Sunrise router adapter. Select it with: php xpsr setup --router=sunrise --install-dependencies"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true,
        "versions": {
          "crystoline/xpsr-api": "0.5.x-dev",
          "crystoline/xpsr-installer": "0.5.x-dev",
          "crystoline/xpsr-auth-jwt": "0.5.x-dev",
          "crystoline/xpsr-orm-eloquent": "0.5.x-dev",
          "crystoline/xpsr-queue": "0.5.x-dev",
          "crystoline/xpsr-mail": "0.5.x-dev",
          "crystoline/xpsr-scheduler": "0.5.x-dev",
          "crystoline/xpsr-storage": "0.5.x-dev",
          "crystoline/xpsr-view-plates": "0.5.x-dev",
          "crystoline/xpsr-view-latte": "0.5.x-dev",
          "crystoline/xpsr-view-blade": "0.5.x-dev",
          "crystoline/xpsr-lock": "0.5.x-dev",
          "crystoline/xpsr-notifications": "0.5.x-dev",
          "crystoline/xpsr-cache": "0.5.x-dev",
          "crystoline/xpsr-database": "0.5.x-dev",
          "crystoline/xpsr-framework": "0.5.x-dev",
          "crystoline/xpsr-http-client": "0.5.x-dev",
          "crystoline/xpsr-validation": "0.5.x-dev",
          "crystoline/xpsr-log-monolog": "0.5.x-dev",
          "crystoline/xpsr-orm-doctrine": "0.5.x-dev",
          "crystoline/xpsr-router-fastroute": "0.5.x-dev",
          "crystoline/xpsr-router-sunrise": "0.5.x-dev"
        }
      }
    }
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Crystoline\\Xpsr\\Api\\Tests\\": "packages/api/tests/",
      "Crystoline\\Xpsr\\Installer\\Tests\\": "packages/installer/tests/",
      "Crystoline\\Xpsr\\Cache\\Tests\\": "packages/cache/tests/",
      "Crystoline\\Xpsr\\Database\\Tests\\": "packages/database/tests/",
      "Crystoline\\Xpsr\\Tests\\": "packages/framework/tests/",
      "Crystoline\\Xpsr\\HttpClient\\Tests\\": "packages/http-client/tests/",
      "Crystoline\\Xpsr\\Notifications\\Tests\\": "packages/notifications/tests/",
      "Crystoline\\Xpsr\\Lock\\Tests\\": "packages/lock/tests/",
      "Crystoline\\Xpsr\\View\\Blade\\Tests\\": "packages/view-blade/tests/",
      "Crystoline\\Xpsr\\View\\Latte\\Tests\\": "packages/view-latte/tests/",
      "Crystoline\\Xpsr\\View\\Plates\\Tests\\": "packages/view-plates/tests/",
      "Crystoline\\Xpsr\\Storage\\Tests\\": "packages/storage/tests/",
      "Crystoline\\Xpsr\\Scheduler\\Tests\\": "packages/scheduler/tests/",
      "Crystoline\\Xpsr\\Mail\\Tests\\": "packages/mail/tests/",
      "Crystoline\\Xpsr\\Queue\\Tests\\": "packages/queue/tests/",
      "Crystoline\\Xpsr\\Orm\\Eloquent\\Tests\\": "packages/orm-eloquent/tests/",
      "Crystoline\\Xpsr\\Auth\\Jwt\\Tests\\": "packages/auth-jwt/tests/",
      "Crystoline\\Xpsr\\Validation\\Symfony\\Tests\\": "packages/validation/tests/",
      "Crystoline\\Xpsr\\Log\\Monolog\\Tests\\": "packages/log-monolog/tests/",
      "Crystoline\\Xpsr\\Orm\\Doctrine\\Tests\\": "packages/orm-doctrine/tests/",
      "Crystoline\\Xpsr\\Router\\FastRoute\\Tests\\": "packages/router-fastroute/tests/",
      "Crystoline\\Xpsr\\Router\\Sunrise\\Tests\\": "packages/router-sunrise/tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "test:packaging": "phpunit --colors=always --group packaging",
    "test:coverage": "phpunit --coverage-text",
    "analyse": "phpstan analyse --no-progress",
    "style": "php-cs-fixer fix --dry-run --diff",
    "style:fix": "php-cs-fixer fix",
    "check": ["@test", "@analyse", "@style"],
    "serve": "@php xpsr serve",
    "serve-docker": "docker compose up -d --build",
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "authors": [
    {
      "name": "Adekunle",
      "email": "crystoline@gmail.com"
    }
  ],
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
